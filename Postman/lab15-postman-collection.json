{
  "info": {
    "name": "Lab15 - Validacion JWT",
    "description": "Laboratorio 15. Ejecuta en orden: 1) Obtener token, 2) Publico, 3) Privado SIN token (401), 4) Privado CON token (200), 5) Refresh. El paso 1 guarda los tokens en variables de la coleccion.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://127.0.0.1:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Obtener token (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Devuelve access y refresh', function () {",
              "    var data = pm.response.json();",
              "    pm.expect(data).to.have.property('access');",
              "    pm.expect(data).to.have.property('refresh');",
              "});",
              "if (pm.response.code === 200) {",
              "    var d = pm.response.json();",
              "    pm.collectionVariables.set('access_token', d.access);",
              "    pm.collectionVariables.set('refresh_token', d.refresh);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"labuser\",\n  \"password\": \"LabPass123!\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/token/",
          "host": ["{{base_url}}"],
          "path": ["api", "token", ""]
        }
      }
    },
    {
      "name": "2 - Recurso publico (GET)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Mensaje acceso publico', function () {",
              "    pm.expect(pm.response.json().mensaje).to.eql('acceso publico');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/publico",
          "host": ["{{base_url}}"],
          "path": ["api", "publico"]
        }
      }
    },
    {
      "name": "3 - Privado SIN token (GET) -> 401",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Sin token devuelve 401 Unauthorized', function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/privado",
          "host": ["{{base_url}}"],
          "path": ["api", "privado"]
        }
      }
    },
    {
      "name": "4 - Privado CON token (GET) -> 200",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Con token devuelve 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Mensaje acceso privado', function () {",
              "    pm.expect(pm.response.json().mensaje).to.eql('acceso privado');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          { "key": "Authorization", "value": "Bearer {{access_token}}" }
        ],
        "url": {
          "raw": "{{base_url}}/api/privado",
          "host": ["{{base_url}}"],
          "path": ["api", "privado"]
        }
      }
    },
    {
      "name": "5 - Refresh token (POST)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Genera nuevo access', function () {",
              "    pm.expect(pm.response.json()).to.have.property('access');",
              "});",
              "if (pm.response.code === 200) {",
              "    pm.collectionVariables.set('access_token', pm.response.json().access);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"refresh\": \"{{refresh_token}}\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/token/refresh/",
          "host": ["{{base_url}}"],
          "path": ["api", "token", "refresh", ""]
        }
      }
    }
  ]
}
